# =============================================================================
# RELAY — Environment Configuration Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is in .gitignore.
# =============================================================================

# ── PUBLIC (safe to expose to the browser via Vite) ──────────────────────────
# Only the Agora App ID is safe for client-side WebRTC channel join.
VITE_AGORA_APP_ID="your_agora_app_id_here"

# Backend API Base URL (Required for GitHub Pages / Vercel static frontend pointing to Render / Railway backend)
# Example: https://relay-backend.onrender.com or https://relay-api.up.railway.app
VITE_API_BASE_URL=""

# ── SERVER-SIDE SECRETS (NEVER add VITE_ prefix to these) ────────────────────

# 1. Agora Developer Credentials
#    Get from: https://console.agora.io/
AGORA_APP_ID="your_agora_app_id_here"
AGORA_APP_CERTIFICATE="your_agora_app_certificate_here"
AGORA_CUSTOMER_ID="your_agora_customer_id_here"
AGORA_CUSTOMER_SECRET="your_agora_customer_secret_here"

# 2. AI Model Providers
#    Gemini: https://aistudio.google.com/
#    OpenAI: https://platform.openai.com/api-keys
#    Deepgram: https://console.deepgram.com/
#    ElevenLabs: https://elevenlabs.io/app/settings/api-keys
GEMINI_API_KEY=""
OPENAI_API_KEY=""
DEEPGRAM_API_KEY=""
ELEVENLABS_API_KEY=""

# 3. Logistics & E-Commerce Real Carriers (Optional - fallback to simulation)
#    Shiprocket: https://app.shiprocket.in/api-user
#    Delhivery: https://track.delhivery.com/
#    17TRACK: https://api.17track.net/
#    Shopify: https://help.shopify.com/en/manual/apps/app-types/custom-apps
SHIPROCKET_TOKEN=""
DELHIVERY_API_KEY=""
TRACK17_API_KEY=""
SHOPIFY_SHOP_URL=""
SHOPIFY_ACCESS_TOKEN=""

# 4. Database & Cache
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/relay_db"
REDIS_URL="redis://localhost:6379"

# 5. Operational Tuning (all optional — defaults shown)
PORT=3000
NODE_ENV="development"
TOOL_TIMEOUT_MS=5000
LLM_TIMEOUT_MS=8000
APPROVAL_EXPIRY_MS=600000
