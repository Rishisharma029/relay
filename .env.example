# =============================================================================
# RELAY — Environment Configuration Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is in .gitignore.
# =============================================================================

# ── PUBLIC (safe to expose to the browser via Vite) ──────────────────────────
# Only the Agora App ID is safe for client-side WebRTC channel join.
VITE_AGORA_APP_ID="your_agora_app_id_here"

# ── SERVER-SIDE SECRETS (NEVER add VITE_ prefix to these) ────────────────────

# 1. Agora Developer Credentials
#    Get from: https://console.agora.io/
AGORA_APP_ID="your_agora_app_id_here"
AGORA_APP_CERTIFICATE="your_agora_app_certificate_here"
AGORA_CUSTOMER_ID="your_agora_customer_id_here"
AGORA_CUSTOMER_SECRET="your_agora_customer_secret_here"

# 2. AI Model Providers
#    OpenAI: https://platform.openai.com/api-keys
#    Deepgram: https://console.deepgram.com/
#    ElevenLabs: https://elevenlabs.io/app/settings/api-keys
OPENAI_API_KEY="sk-..."
DEEPGRAM_API_KEY=""
ELEVENLABS_API_KEY=""

# 3. Database & Cache
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/relay_db"
REDIS_URL="redis://localhost:6379"

# 4. Operational Tuning (all optional — defaults shown)
PORT=3000
NODE_ENV="development"
TOOL_TIMEOUT_MS=5000
LLM_TIMEOUT_MS=8000
APPROVAL_EXPIRY_MS=600000
