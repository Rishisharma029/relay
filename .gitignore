# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# ── Diagnostic / Coverage ────────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ── Dependency directories ────────────────────────────────────────────────────
node_modules/
jspm_packages/
web_modules/

# ── Production build output ───────────────────────────────────────────────────
dist/
dist-ssr/
build/
out/
.output/

# ── Environment variables — NEVER commit secrets ──────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.local
# .env.example is intentionally committed (no real secrets inside)

# ── Editor & IDE ──────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.fleet/
.project
.classpath
.settings/

# ── OS generated ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# ── Vite / TypeScript build cache ─────────────────────────────────────────────
.vite/
*.tsbuildinfo
tsconfig.tsbuildinfo

# ── Temporary files ───────────────────────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
*.orig

# ── Testing ───────────────────────────────────────────────────────────────────
.jest-cache/
test-results/
playwright-report/
e2e/

# ── Package manager locks — keep only one ────────────────────────────────────
# yarn.lock   ← uncomment if using Yarn
# pnpm-lock.yaml ← uncomment if using pnpm

# ── Deployment / CI ───────────────────────────────────────────────────────────
.vercel/
.netlify/
.railway/
.render/
.fly/

# ── Misc ──────────────────────────────────────────────────────────────────────
*.pid
*.seed
*.pid.lock
.cache/
